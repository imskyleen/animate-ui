{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-primitives-base-select",
  "type": "registry:ui",
  "title": "Base Select Demo",
  "description": "Demo showing an animated base select.",
  "registryDependencies": ["@animate-ui/primitives-base-select"],
  "files": [
