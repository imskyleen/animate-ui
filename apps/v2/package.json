    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.18",
    "lucide-react": "^1.47.0",
    "motion": "catalog:",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "catalog:",
