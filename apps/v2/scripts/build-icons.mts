import {
  existsSync,
  mkdirSync,
  readFileSync,
  readdirSync,
  writeFileSync,
} from 'node:fs';
import path from 'node:path';

const root = path.join(import.meta.dirname, '..');
const outDir = path.join(root, 'public', 'r');
mkdirSync(outDir, { recursive: true });

type Meta = {
  title: string;
  description: string;
  keywords: string[];
  categories: string[];
  added?: string;
};

const LIBRARIES = [
  {
    dir: 'icons',
    prefix: 'icons-lucide',
    target: '@components/animate-ui/icons',
  },
  {
    dir: 'hugeicons',
    prefix: 'icons-hugeicons',
    target: '@components/animate-ui/icons/hugeicons',
  },
];

for (const library of LIBRARIES) build(library);

function build({ dir, prefix, target }: (typeof LIBRARIES)[number]) {
  const iconsDir = path.join(root, 'registry', dir);
  const categoriesFile = path.join(
    root,
    'registry',
    'icons',
    'categories.json',
  );
  const categoryTitles = (
    existsSync(categoriesFile)
      ? JSON.parse(readFileSync(categoriesFile, 'utf8'))
      : {}
  ) as Record<string, string>;

  const names = readdirSync(iconsDir, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
    .sort();

  const list: (Meta & { name: string })[] = [];

  for (const name of names) {
    const meta = JSON.parse(
      readFileSync(path.join(iconsDir, name, 'meta.json'), 'utf8'),
    ) as Meta;
    const content = readFileSync(
      path.join(iconsDir, name, 'index.tsx'),
      'utf8',
    );
    writeFileSync(
      path.join(outDir, `${prefix}-${name}.json`),
      JSON.stringify(
        {
          $schema: 'https://ui.shadcn.com/schema/registry-item.json',
          name: `${prefix}-${name}`,
          type: 'registry:ui',
          title: meta.title,
          description: meta.description,
          dependencies: ['@animate-ui/react', 'motion'],
          files: [
            {
              path: `registry/${dir}/${name}/index.tsx`,
              type: 'registry:ui',
              target: `${target}/${name}.tsx`,
              content,
            },
          ],
          meta: { keywords: meta.keywords },
        },
        null,
        2,
      ),
    );
    list.push({ name, ...meta });
  }

  writeFileSync(
    path.join(iconsDir, 'index.ts'),
    [
      '// Generated by scripts/build-icons.mts. Do not edit.',
      "import type { ComponentType } from 'react';",
      "import type { IconProps } from '@animate-ui/react/icons';",
      '',
      'export type IconEntry = {',
      '  name: string;',
      '  title: string;',
      '  keywords: string[];',
      '  categories: string[];',
      '  added?: string;',
      '  load: () => Promise<{',
      '    default?: never;',
      '    animations: Record<string, unknown>;',
      '    [component: string]: unknown;',
      '  }>;',
      '};',
      '',
      'export const ICONS: IconEntry[] = [',
      ...list.map(
        (icon) =>
          `  { name: ${JSON.stringify(icon.name)}, title: ${JSON.stringify(icon.title.replace(/ Icon$/, ''))}, keywords: ${JSON.stringify(icon.keywords)}, categories: ${JSON.stringify(icon.categories)}, ${icon.added ? `added: ${JSON.stringify(icon.added)}, ` : ''}load: () => import('./${icon.name}') },`,
      ),
      '];',
      '',
      '/** Every category an icon is in, by title. */',
      `export const CATEGORIES: { id: string; title: string }[] = ${JSON.stringify(
        [...new Set(list.flatMap((icon) => icon.categories))]
          .map((id) => {
            if (!categoryTitles[id])
              throw new Error(`No title for category ${id}`);
            return { id, title: categoryTitles[id] };
          })
          .sort((a, b) => a.title.localeCompare(b.title)),
      )};`,
      '',
      '/** The icon component a loaded module exports (its name, whatever the casing). */',
      'export function iconComponent(mod: Record<string, unknown>, name: string) {',
      "  const target = name.replace(/-/g, '').toLowerCase();",
      '  const key = Object.keys(mod).find((k) => k.toLowerCase() === target);',
      '  return (key ? mod[key] : undefined) as ComponentType<IconProps<string>> | undefined;',
      '}',
      '',
    ].join('\n'),
  );

  console.log(`${list.length} ${dir}`);
}
