// Writes src/primitives/reka-ui/index.ts. Vue's SFC compiler can't follow
// `export *` to resolve the type given to `defineProps<…>()`, so every reka-ui
// type is re-exported by name; values go through the star export.
import { readdirSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';
import ts from 'typescript';

const root = path.resolve(import.meta.dirname, '..');
const require = createRequire(import.meta.url);
const entry = path.join(
  path.dirname(require.resolve('reka-ui/package.json')),
  'dist/index.d.ts',
);

const program = ts.createProgram([entry], {
  module: ts.ModuleKind.ESNext,
  moduleResolution: ts.ModuleResolutionKind.Bundler,
  skipLibCheck: true,
});
const checker = program.getTypeChecker();
const source = program.getSourceFile(entry)!;
const module = checker.getSymbolAtLocation(source)!;

const ownDir = path.join(root, 'src/primitives/reka-ui');
const parts = readdirSync(ownDir, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name)
  .sort();

const ownNames = new Set<string>();
const ownExports = parts.map((part) => {
  const file = ts.createSourceFile(
    'index.ts',
    ts.sys.readFile(path.join(ownDir, part, 'index.ts'))!,
    ts.ScriptTarget.Latest,
  );
  const names: string[] = [];
  file.forEachChild((node) => {
    if (!ts.isExportDeclaration(node) || !node.exportClause) return;
    if (!ts.isNamedExports(node.exportClause)) return;
    for (const element of node.exportClause.elements) {
      const name = element.name.text;
      const typeOnly = node.isTypeOnly || element.isTypeOnly;
      names.push(typeOnly ? `type ${name}` : name);
      ownNames.add(name);
    }
  });
  return `export {\n${names.map((name) => `  ${name},`).join('\n')}\n} from './${part}';`;
});

const types = checker
  .getExportsOfModule(module)
  .filter((symbol) => {
    const target =
      symbol.flags & ts.SymbolFlags.Alias
        ? checker.getAliasedSymbol(symbol)
        : symbol;
    return !(target.flags & ts.SymbolFlags.Value);
  })
  .map((symbol) => symbol.name)
  .filter((name) => !ownNames.has(name))
  .sort();

const output = `// Generated by scripts/generate-barrel.mts. Do not edit.
export * from 'reka-ui';

export type {
${types.map((name) => `  ${name},`).join('\n')}
} from 'reka-ui';

${ownExports.join('\n\n')}
`;

writeFileSync(path.join(ownDir, 'index.ts'), output);
console.log(
  `reka-ui barrel: ${types.length} types, ${parts.length} animated parts`,
);
