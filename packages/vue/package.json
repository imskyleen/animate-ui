{
  "name": "@animate-ui/vue",
  "version": "2.3.0",
  "type": "module",
  "sideEffects": false,
  "description": "Animated drop-in primitives for reka-ui, built with Motion for Vue.",
  "keywords": [
    "animate-ui",
    "vue",
    "motion",
    "motion-v",
    "animation",
    "reka-ui",
    "shadcn-vue",
    "primitives",
    "components"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imskyleen/animate-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://animate-ui.com",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-publish.mjs agent && pnpm build && node ../../scripts/check-publish.mjs dist",
    "build": "node scripts/generate-barrel.mts && tsdown",
    "dev": "tsdown --watch",
    "gen": "node scripts/generate-barrel.mts",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "exports": {
    "./*": "./src/*/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*/index.d.ts",
        "default": "./dist/*/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@floating-ui/vue": "^2.0.0",
    "embla-carousel-vue": "^8.6.0",
    "motion-v": "^2.8.0",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0",
    "vue": "^3.5.0",
    "vue-input-otp": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/vue": {
      "optional": true
    },
    "embla-carousel-vue": {
      "optional": true
    },
    "reka-ui": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "vue-input-otp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@workspace/eslint-config": "workspace:*",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "eslint": "catalog:",
    "motion-v": "^2.8.0",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.44",
    "vue-input-otp": "^0.4.0"
  }
}
