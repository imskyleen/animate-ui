<script setup lang="ts">
import type { PrimitiveProps } from "@animate-ui/vue/primitives/reka-ui"

import type { HTMLAttributes } from "vue"
import type { ButtonVariants } from "@/registry/new-york-v4/ui/button"
import { CheckIcon, CopyIcon } from "@lucide/vue"
import { cn } from "cn"
import { Button } from "@/registry/new-york-v4/ui/button"
import { CopyButton, CopyButtonIcon } from "@animate-ui/vue/primitives/buttons/copy"
import { ref } from "vue"

defineOptions({ inheritAttrs: false })

const props = withDefaults(defineProps<PrimitiveProps & {
  value: string
  variant?: ButtonVariants["variant"]
  size?: ButtonVariants["size"]
  class?: HTMLAttributes["class"]
}>(), {
  as: "button",
  variant: "ghost",
  size: "icon-xs",
})

const copied = ref(false)
</script>

<template>
  <CopyButton
    as-child
    data-slot="code-block-copy-button"
    :content="props.value"
    :delay="2000"
    @copied-change="(value: boolean) => (copied = value)"
  >
    <Button
      v-bind="$attrs"
      :data-copied="copied || undefined"
      :as="as"
      :as-child="asChild"
      :variant="variant"
      :size="size"
      :aria-label="copied ? 'Copied' : 'Copy'"
      :class="cn('', props.class)"
    >
      <CopyButtonIcon>
        <template #icon>
          <CopyIcon />
        </template>
        <template #copied-icon>
          <CheckIcon />
        </template>
      </CopyButtonIcon>
    </Button>
  </CopyButton>
  <span aria-live="polite" class="sr-only">{{ copied ? "Copied" : "" }}</span>
</template>
