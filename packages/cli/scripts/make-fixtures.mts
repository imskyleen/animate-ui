// Builds CLI test fixtures from shadcn/ui sources: one file per create style,
// with its cn-* classes inlined the way `shadcn add` does at install time.
//   node scripts/make-fixtures.mts <shadcn-dir> <radix|base|aria> <component...>
// <shadcn-dir> holds style-<style>.css and <base>/<component>.tsx, from
// github.com/shadcn-ui/ui apps/v4/registry/{styles,bases/<base>/ui}.
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';

const STYLES = ['luma', 'lyra', 'maia', 'mira', 'nova', 'rhea', 'sera', 'vega'];
const LIBRARY = {
  radix: 'radix-ui',
  base: 'base-ui',
  aria: 'react-aria',
} as const;

const [dir, base, ...components] = process.argv.slice(2) as [
  string,
  keyof typeof LIBRARY,
  ...string[],
];
if (!dir || !LIBRARY[base] || components.length === 0) {
  console.error(
    'Usage: make-fixtures.mts <shadcn-dir> <radix|base|aria> <component...>',
  );
  process.exit(1);
}

const out = path.join(
  import.meta.dirname,
  '..',
  'test',
  'fixtures',
  LIBRARY[base],
);
mkdirSync(out, { recursive: true });

for (const style of STYLES) {
  const css = readFileSync(path.join(dir, `style-${style}.css`), 'utf8');
  const rules = new Map<string, string>();
  for (const [, name, classes] of css.matchAll(
    /\.(cn-[\w-]+)\s*\{\s*@apply\s+([^;}]+)/g,
  ))
    rules.set(name!, classes!.trim());

  for (const component of components) {
    const source = readFileSync(
      path.join(dir, base, `${component}.tsx`),
      'utf8',
    );
    // Inline cn-* tokens in string literals; unknown ones disappear.
    const code = source.replace(
      /(["'`])([^"'`\n]*\bcn-[^"'`\n]*)\1/g,
      (_, quote: string, value: string) => {
        const tokens = value
          .split(/\s+/)
          .flatMap((token) =>
            token.startsWith('cn-') ? (rules.get(token) ?? '') : token,
          )
          .filter(Boolean);
        return `${quote}${tokens.join(' ')}${quote}`;
      },
    );
    const header = `// shadcn/ui create: ${base} base, ${style} style (generated by scripts/make-fixtures.mts).\n`;
    writeFileSync(path.join(out, `${component}.${style}.tsx`), header + code);
  }
}
console.log(
  `${components.length * STYLES.length} fixture(s) in ${path.relative(process.cwd(), out)}`,
);
