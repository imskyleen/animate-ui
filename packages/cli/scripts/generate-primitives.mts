// Writes src/primitives/index.ts from the src/primitives/<library>/<name>.ts
// files, so adding a primitive never touches a shared list.
//   pnpm --filter @animate-ui/cli gen
import { readdirSync, writeFileSync } from 'node:fs';
import path from 'node:path';

const root = path.join(import.meta.dirname, '..', 'src', 'primitives');

const files = readdirSync(root, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .flatMap((library) =>
    readdirSync(path.join(root, library.name))
      .filter((file) => file.endsWith('.ts'))
      .map((file) => `${library.name}/${file.replace(/\.ts$/, '')}`),
  )
  .sort();

const id = (file: string) =>
  file.replace(/[^a-zA-Z0-9]+(.)/g, (_, c: string) => c.toUpperCase());

writeFileSync(
  path.join(root, 'index.ts'),
  [
    '// Generated by scripts/generate-primitives.mts. Do not edit.',
    "import type { Primitive } from '../lib/primitives';",
    '',
    ...files.map((file) => `import ${id(file)} from './${file}';`),
    '',
    `export const PRIMITIVES: Primitive[] = [${files.map(id).join(', ')}];`,
    '',
  ].join('\n'),
);
console.log(`${files.length} primitive(s)`);
