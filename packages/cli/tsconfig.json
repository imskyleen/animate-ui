{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "tsdown.config.ts"
  ],
  "exclude": [
    "test/fixtures",
    "test/fixtures-vue",
    "test/__snapshots__"
  ]
}
